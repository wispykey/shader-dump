shader_type canvas_item;

uniform float speed = 2.0;
uniform float frequency_y = 4.0;
uniform float amplitude_y = 40.0;

uniform float frequency_x = 4.0;
uniform float amplitude_x = 20.0;

void vertex() {
	VERTEX.y += sin((-TIME * speed + UV.x) * frequency_y) * amplitude_y * UV.x;
	// Multiplying by UV.x means, have a lesser effect towards UV.x = 0 (closer to left side of texture)
	// and a greater effect towards UV.x = 1 (closer to right side of texture)
	// which is perfect for a flag, where the flag is more stable near the pole (on left side in this case)
	VERTEX.x += sin((UV.x - TIME * speed) * frequency_x) * amplitude_x * UV.x;
	
	// Incline
	VERTEX.x += -UV.y * 20.;
}

void fragment() {
	// Set white base
	COLOR = vec4(1.);
	
	// Carve out circle
	float circle = step(distance(UV, vec2(0.5)), 0.2);
	COLOR.rgb = mix(vec3(1.), vec3(1., 0., 0.), circle);
	
	// Hide excess border generated by polygon points
	COLOR.a *= step(UV.x, 1.0);
	COLOR.a *= step(0., UV.x);
	COLOR.a *= step(UV.y, 1.0);
	COLOR.a *= step(0., UV.y);
}
